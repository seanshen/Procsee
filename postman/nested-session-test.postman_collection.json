{
	"info": {
		"_postman_id": "nested-session-test-001",
		"name": "Nested Session Test",
		"description": "Test deeply nested Java objects in HttpSession with Spring Session SaveMode.ALWAYS",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Create Employee with Nested Objects",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response contains employee\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.employee).to.exist;",
							"    pm.expect(jsonData.employee.name).to.equal(\"John Doe\");",
							"});",
							"",
							"// Store session ID for subsequent requests",
							"var setCookie = pm.response.headers.get(\"Set-Cookie\");",
							"if (setCookie) {",
							"    var sessionMatch = setCookie.match(/SESSION=([^;]+)/);",
							"    if (sessionMatch) {",
							"        pm.collectionVariables.set(\"sessionCookie\", sessionMatch[1]);",
							"    }",
							"}",
							"",
							"// Store original values for comparison",
							"var jsonData = pm.response.json();",
							"pm.collectionVariables.set(\"originalName\", jsonData.employee.name);",
							"pm.collectionVariables.set(\"originalEmail\", jsonData.employee.contact.email);",
							"pm.collectionVariables.set(\"originalCity\", jsonData.employee.company.contact.address.city);",
							"",
							"setTimeout(function(){}, 2000);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"id\": 1001,\n  \"name\": \"John Doe\",\n  \"title\": \"Senior Developer\",\n  \"salary\": 95000.0,\n  \"contact\": {\n    \"phone\": \"555-1234\",\n    \"email\": \"john@example.com\",\n    \"address\": {\n      \"street\": \"123 Main St\",\n      \"city\": \"New York\",\n      \"state\": \"NY\",\n      \"zipCode\": \"10001\"\n    }\n  },\n  \"company\": {\n    \"name\": \"Tech Corp\",\n    \"industry\": \"Software\",\n    \"contact\": {\n      \"phone\": \"555-5678\",\n      \"email\": \"info@techcorp.com\",\n      \"address\": {\n        \"street\": \"456 Corporate Blvd\",\n        \"city\": \"San Francisco\",\n        \"state\": \"CA\",\n        \"zipCode\": \"94102\"\n      }\n    }\n  }\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/session/employee",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "session", "employee"]
				}
			},
			"response": []
		},
		{
			"name": "2. Read Employee - Verify Initial State",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Employee exists in session\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.exists).to.be.true;",
							"    pm.expect(jsonData.employee).to.exist;",
							"});",
							"",
							"pm.test(\"All nested properties match original\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.employee.name).to.equal(pm.collectionVariables.get(\"originalName\"));",
							"    pm.expect(jsonData.employee.contact.email).to.equal(pm.collectionVariables.get(\"originalEmail\"));",
							"    pm.expect(jsonData.employee.company.contact.address.city).to.equal(pm.collectionVariables.get(\"originalCity\"));",
							"});",
							"",
							"setTimeout(function(){}, 2000);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Cookie",
						"value": "SESSION={{sessionCookie}}"
					}
				],
				"url": {
					"raw": "http://localhost:8080/api/session/employee",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "session", "employee"]
				}
			},
			"response": []
		},
